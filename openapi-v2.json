{
  "openapi": "3.1.0",
  "info": {
    "title": "Seta Telecom ERP Connector",
    "version": "1.0.5-json",
    "description": "Conector seguro entre ChatGPT Actions e a API Betel Tecnologia."
  },
  "servers": [
    {"url": "https://seta-erp-connector-production-1255.up.railway.app"}
  ],
  "paths": {
    "/erp/clientes": {
      "get": {
        "operationId": "buscarClientes",
        "summary": "Busca clientes no ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}},
          {"name": "cnpj", "in": "query", "schema": {"type": "string"}},
          {"name": "email", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Resultado da busca"}}
      },
      "post": {
        "operationId": "criarCliente",
        "summary": "Cria um cliente no ERP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tipo_pessoa", "nome"],
                "properties": {
                  "tipo_pessoa": {"type": "string", "enum": ["PF", "PJ", "ES"]},
                  "nome": {"type": "string"},
                  "razao_social": {"type": "string"},
                  "cnpj": {"type": "string"},
                  "cpf": {"type": "string"},
                  "email": {"type": "string"},
                  "telefone": {"type": "string"},
                  "celular": {"type": "string"},
                  "usuario_id": {"type": "string"},
                  "loja_id": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {"200": {"description": "Cliente criado"}}
      }
    },
    "/erp/produtos": {
      "get": {
        "operationId": "buscarProdutos",
        "summary": "Busca produtos no ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}},
          {"name": "codigo_interno", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Produtos encontrados"}}
      }
    },
    "/erp/usuarios": {
      "get": {
        "operationId": "buscarUsuarios",
        "summary": "Lista ou busca usuarios e vendedores do ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Usuarios encontrados"}}
      }
    },
    "/erp/situacoes-orcamentos": {
      "get": {
        "operationId": "buscarSituacoesOrcamento",
        "summary": "Lista situacoes disponiveis para orcamentos",
        "responses": {"200": {"description": "Situacoes encontradas"}}
      }
    },
    "/erp/orcamentos": {
      "get": {
        "operationId": "buscarOrcamentos",
        "summary": "Busca orcamentos existentes",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "codigo", "in": "query", "schema": {"type": "integer"}},
          {"name": "cliente_id", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Orcamentos encontrados"}}
      },
      "post": {
        "operationId": "criarOrcamento",
        "summary": "Cria um orcamento ou proposta no ERP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tipo", "codigo", "cliente_id", "data", "situacao_id"],
                "properties": {
                  "tipo": {"type": "string"},
                  "codigo": {"type": "integer"},
                  "cliente_id": {"type": "string"},
                  "vendedor_id": {"type": "string"},
                  "data": {"type": "string"},
                  "situacao_id": {"type": "string"},
                  "validade": {"type": "string"},
                  "introducao": {"type": "string"},
                  "observacoes": {"type": "string"},
                  "observacoes_interna": {"type": "string"},
                  "valor_frete": {"type": "number"},
                  "desconto_valor": {"type": "string"},
                  "desconto_porcentagem": {"type": "string"},
                  "produtos": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "produto": {
                          "type": "object",
                          "properties": {
                            "id": {"type": "string"},
                            "variacao_id": {"type": "string"},
                            "quantidade": {"type": "string"},
                            "valor_venda": {"type": "string"},
                            "tipo_valor_id": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {"200": {"description": "Orcamento criado"}}
      }
    },
    "/erp/orcamentos/{id}": {
      "get": {
        "operationId": "consultarOrcamento",
        "summary": "Consulta um orcamento pelo ID interno",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Orcamento encontrado"}}
      }
    },
    "/erp/recebimentos": {
      "get": {
        "operationId": "buscarRecebimentos",
        "summary": "Busca recebimentos financeiros no ERP",
        "description": "Use para recibos ou recebimentos. Pode filtrar por cliente, periodo, status, descricao, plano de contas e forma de pagamento.",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "limit", "in": "query", "schema": {"type": "integer"}},
          {"name": "codigo", "in": "query", "schema": {"type": "integer"}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}},
          {"name": "cliente_id", "in": "query", "schema": {"type": "integer"}},
          {"name": "data_inicio", "in": "query", "schema": {"type": "string"}},
          {"name": "data_fim", "in": "query", "schema": {"type": "string"}},
          {"name": "valor_inicio", "in": "query", "schema": {"type": "number"}},
          {"name": "valor_fim", "in": "query", "schema": {"type": "number"}},
          {"name": "liquidado", "in": "query", "description": "ab=Em aberto, at=Em atraso, pg=Confirmado", "schema": {"type": "string", "enum": ["ab", "at", "pg"]}},
          {"name": "plano_contas_id", "in": "query", "schema": {"type": "integer"}},
          {"name": "centro_custo_id", "in": "query", "schema": {"type": "integer"}},
          {"name": "conta_bancaria_id", "in": "query", "schema": {"type": "integer"}},
          {"name": "forma_pagamento_id", "in": "query", "schema": {"type": "integer"}},
          {"name": "ordenacao", "in": "query", "schema": {"type": "string"}},
          {"name": "direcao", "in": "query", "schema": {"type": "string", "enum": ["asc", "desc"]}}
        ],
        "responses": {"200": {"description": "Recebimentos encontrados"}}
      },
      "post": {
        "operationId": "criarRecebimento",
        "summary": "Cria um recebimento ou recibo de locacao no ERP",
        "description": "Antes de criar, localize cliente, plano de contas, forma de pagamento e conta bancaria corretos. Exija confirmacao do usuario antes de gravar.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["descricao", "data_vencimento", "plano_contas_id", "forma_pagamento_id", "conta_bancaria_id", "valor", "data_competencia"],
                "properties": {
                  "descricao": {"type": "string"},
                  "data_vencimento": {"type": "string"},
                  "valor": {"type": "number"},
                  "juros": {"type": "number"},
                  "desconto": {"type": "number"},
                  "valor_total": {"type": "number"},
                  "centro_custo_id": {"type": "integer"},
                  "nome_centro_custo": {"type": "string"},
                  "conta_bancaria_id": {"type": "integer"},
                  "nome_conta_bancaria": {"type": "string"},
                  "forma_pagamento_id": {"type": "integer"},
                  "nome_forma_pagamento": {"type": "string"},
                  "entidade": {"type": "string"},
                  "cliente_id": {"type": "integer"},
                  "nome_cliente": {"type": "string"},
                  "liquidado": {"type": "string"},
                  "data_liquidacao": {"type": "string"},
                  "data_competencia": {"type": "string"},
                  "plano_contas_id": {"type": "integer"},
                  "nome_plano_conta": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {"200": {"description": "Recebimento criado"}}
      }
    },
    "/erp/recebimentos/{id}": {
      "get": {
        "operationId": "consultarRecebimento",
        "summary": "Consulta um recebimento pelo ID interno",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Recebimento encontrado"}}
      }
    },
    "/erp/planos-contas": {
      "get": {
        "operationId": "buscarPlanosContas",
        "summary": "Busca planos de contas do ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Planos de contas encontrados"}}
      }
    },
    "/erp/formas-pagamentos": {
      "get": {
        "operationId": "buscarFormasPagamentos",
        "summary": "Busca formas de pagamento do ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Formas de pagamento encontradas"}}
      }
    },
    "/erp/contas-bancarias": {
      "get": {
        "operationId": "buscarContasBancarias",
        "summary": "Busca contas bancarias do ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Contas bancarias encontradas"}}
      }
    },
    "/erp/regras-faturamento": {
      "get": {
        "operationId": "buscarRegraFaturamento",
        "summary": "Busca a regra de faturamento cadastrada para um cliente",
        "description": "Use antes de calcular vencimento ou gerar fatura. Se nao houver regra, nao invente parametros; solicite configuracao do cliente.",
        "parameters": [
          {"name": "cliente", "in": "query", "schema": {"type": "string"}},
          {"name": "cliente_id", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Regra encontrada"},
          "404": {"description": "Cliente sem regra de faturamento cadastrada"}
        }
      }
    },
    "/erp/regras-faturamento/calcular": {
      "post": {
        "operationId": "calcularVencimentoFatura",
        "summary": "Calcula emissao e vencimento de uma nova fatura conforme a regra do cliente",
        "description": "Para Veolia, usa vencimento da fatura anterior + 45 dias e ajusta para a primeira quarta-feira igual ou posterior. Data de emissao e a data da edicao.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cliente", "vencimento_anterior", "data_edicao"],
                "properties": {
                  "cliente": {"type": "string"},
                  "cliente_id": {"type": "string"},
                  "vencimento_anterior": {"type": "string", "description": "YYYY-MM-DD"},
                  "data_edicao": {"type": "string", "description": "YYYY-MM-DD; sera a data de emissao"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Calculo realizado"},
          "404": {"description": "Cliente sem regra de faturamento cadastrada"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthMarker": {
        "type": "object",
        "properties": {
          "status": {"type": "string"}
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {"bearerAuth": []}
  ]
}
