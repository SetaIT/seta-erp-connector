{
  "version": 5,
  "currency_default": "BRL",
  "deal_name_pattern": "{numero_proposta} - {empresa} - {solucao}",
  "types": {
    "locacao": {
      "label": "Proposta de Locação",
      "requires_months": true,
      "deal_amount_rule": "monthly_value_times_months",
      "introduction_pattern": "Proposta de Locação - {meses} meses\nValor mensal: {valor_formatado}/mês",
      "hubspot_pipeline": "9501279",
      "hubspot_stage_aguardando_proposta": "9501282",
      "hubspot_stage_proposta_enviada": "9501283",
      "hubspot_stage_ganho": "14236286"
    },
    "compra": {
      "label": "Proposta de Compra",
      "requires_months": false,
      "deal_amount_rule": "proposal_total",
      "currency_required_when_usd": true,
      "introduction_pattern_brl": "Proposta de Compra\nValor total: {valor_formatado}",
      "introduction_pattern_usd": "Proposta de Compra - USD\nValor total: {valor_formatado}",
      "hubspot_pipeline": "default",
      "hubspot_stage_aguardando_proposta": "20205433",
      "hubspot_stage_proposta_enviada": "qualifiedtobuy",
      "hubspot_stage_ganho": "20072970"
    },
    "spareparts": {
      "label": "Proposta de SpareParts",
      "requires_months": true,
      "deal_amount_rule": "explicit_value_until_confirmed",
      "introduction_pattern": "Proposta de SpareParts - {meses} meses\nValor mensal: {valor_formatado}/mês",
      "hubspot_pipeline": "9501279",
      "hubspot_stage_aguardando_proposta": "9501282",
      "hubspot_stage_proposta_enviada": "9501283",
      "hubspot_stage_ganho": "14236286"
    }
  },
  "deal_won": {
    "reason_property": "descricao_motivo_ganho__clonado_",
    "allowed_reasons": [
      "Nossa Solução foi a Melhor",
      "Disponibilidade",
      "Prazo de Entrega",
      "Relacionamento",
      "Preço"
    ],
    "allow_multiple_reasons": true,
    "separator": ";",
    "require_reason": true,
    "require_explicit_confirmation": true
  },
  "email": {
    "template_name": "Envio de Proposta - Ago 2025",
    "delivery_provider": "Outlook",
    "delivery_orchestration": "railway_unified_backend",
    "hubspot_activity_log": true,
    "sales_template_send_api_supported": false,
    "move_stage_only_after_confirmed_send": true,
    "salutation_single_recipient": "first_name",
    "salutation_multiple_recipients": "neutral"
  },
  "workflow": {
    "backend": "seta-erp-connector",
    "single_action": true,
    "unified_context_endpoint": "/erp/propostas/{numero}/contexto",
    "require_proposal_type_before_create": true,
    "require_solution_before_create": true,
    "require_validity_before_create": true,
    "require_explicit_confirmation_before_erp_write": true,
    "require_explicit_confirmation_before_hubspot_write": true,
    "check_deal_duplicate_by_numero_da_proposta": true,
    "company_lookup_key_hubspot": "domain_then_name_candidates",
    "company_lookup_strategy": [
      "domain",
      "full_name",
      "simplified_name"
    ],
    "return_company_candidates": true,
    "require_user_company_selection_when_multiple": true,
    "associate_all_selected_contacts_to_deal": true,
    "deal_number_property": "numero_da_proposta",
    "deal_link_property": "link_da_proposta",
    "deal_solution_property": "solucao",
    "deal_currency_property": "deal_currency_code",
    "deal_amount_property": "amount",
    "lifecycle": [
      "erp_proposal",
      "hubspot_deal",
      "proposal_email",
      "followup_analysis",
      "followup_email",
      "won_or_lost",
      "post_sale"
    ]
  }
}
