{
  "version": 8,
  "currency_default": "BRL",
  "deal_name_pattern": "{numero_proposta} - {empresa} - {solucao}",
  "introduction": {
    "replace_existing_text": true,
    "fixed_footer": "A disponibilidade dos produtos e os preços apresentados estão sujeitos a alterações sem aviso prévio.\n\nPara cotações expressas em dólar, os valores serão convertidos para BRL (Reais) utilizando a PTAX vigente na data do faturamento.\n\nA Seta Telecom apresenta esta proposta para o fornecimento da solução descrita abaixo, considerando os requisitos e necessidades informados pelo cliente.\n\nCom mais de 15 anos de atuação no mercado nacional e relacionamento com diversos fabricantes e fornecedores, buscamos oferecer soluções tecnologicamente atualizadas, competitivas e adequadas às necessidades de cada projeto.\n\nEsta proposta contempla exclusivamente os produtos, serviços e condições expressamente descritos neste documento."
  },
  "types": {
    "locacao": {
      "label": "Proposta de Locação",
      "requires_months": true,
      "requires_delivery_term": true,
      "delivery_input": "prazo_entrega_dias",
      "delivery_date_field": "prazo_entrega",
      "delivery_date_rule": "proposal_date_plus_calendar_days",
      "requires_freight": true,
      "requires_sla": true,
      "deal_amount_rule": "monthly_value_times_months",
      "introduction_pattern": "Proposta de Locação – {meses} Meses\n\nValor mensal: {valor_formatado}\nPrazo estimado de entrega: {prazo_entrega}\nFrete: {frete_formatado}\nSLA: {sla}",
      "payment_terms": {
        "condicao_pagamento": "a_vista",
        "numero_parcelas": 1,
        "vencimento_dias_apos_data_proposta": 30,
        "exibir_pagamento": true
      },
      "hubspot_pipeline": "9501279",
      "hubspot_stage_aguardando_proposta": "9501282",
      "hubspot_stage_proposta_enviada": "9501283",
      "hubspot_stage_ganho": "14236286"
    },
    "compra": {
      "label": "Proposta de Compra",
      "requires_months": false,
      "deal_amount_rule": "proposal_total",
      "currency_required_when_usd": true,
      "introduction_pattern_brl": "Proposta de Compra\n\nValor total: {valor_formatado}",
      "introduction_pattern_usd": "Proposta de Compra – USD\n\nValor total: {valor_formatado}",
      "hubspot_pipeline": "default",
      "hubspot_stage_aguardando_proposta": "20205433",
      "hubspot_stage_proposta_enviada": "qualifiedtobuy",
      "hubspot_stage_ganho": "20072970"
    },
    "spareparts": {
      "label": "Proposta de SpareParts",
      "requires_months": true,
      "requires_sla": true,
      "deal_amount_rule": "explicit_value_until_confirmed",
      "introduction_pattern": "Proposta de SpareParts – {meses} Meses\n\nValor mensal: {valor_formatado}\nSLA: {sla}\n\nObservação: a abertura do primeiro chamado estará sujeita a uma carência de 30 dias contados a partir do início da vigência contratual.",
      "payment_terms": {
        "condicao_pagamento": "a_vista",
        "numero_parcelas": 1,
        "vencimento_dias_apos_data_proposta": 30,
        "exibir_pagamento": true
      },
      "hubspot_pipeline": "9501279",
      "hubspot_stage_aguardando_proposta": "9501282",
      "hubspot_stage_proposta_enviada": "9501283",
      "hubspot_stage_ganho": "14236286"
    }
  },
  "deal_won": {
    "reason_property": "descricao_motivo_ganho__clonado_",
    "allowed_reasons": [
      "Nossa Solução foi a Melhor",
      "Disponibilidade",
      "Prazo de Entrega",
      "Relacionamento",
      "Preço"
    ],
    "allow_multiple_reasons": true,
    "separator": ";",
    "require_reason": true,
    "require_explicit_confirmation": true
  },
  "email": {
    "template_name": "Envio de Proposta - Ago 2025",
    "delivery_provider": "Outlook",
    "delivery_orchestration": "railway_unified_backend",
    "hubspot_activity_log": true,
    "sales_template_send_api_supported": false,
    "move_stage_only_after_confirmed_send": true,
    "salutation_single_recipient": "first_name",
    "salutation_multiple_recipients": "neutral"
  },
  "workflow": {
    "backend": "seta-erp-connector",
    "single_action": true,
    "unified_context_endpoint": "/erp/propostas/{numero}/contexto",
    "require_proposal_type_before_create": true,
    "require_solution_before_create": true,
    "require_validity_before_create": true,
    "apply_type_payment_terms_before_create": true,
    "payment_due_date_base": "proposal_date",
    "replace_existing_introduction_before_create": true,
    "require_explicit_confirmation_before_erp_write": true,
    "require_explicit_confirmation_before_hubspot_write": true,
    "check_deal_duplicate_by_numero_da_proposta": true,
    "company_lookup_key_hubspot": "domain_then_name_candidates",
    "company_lookup_strategy": [
      "domain",
      "full_name",
      "simplified_name"
    ],
    "return_company_candidates": true,
    "require_user_company_selection_when_multiple": true,
    "associate_all_selected_contacts_to_deal": true,
    "deal_number_property": "numero_da_proposta",
    "deal_link_property": "link_da_proposta",
    "deal_solution_property": "solucao",
    "deal_currency_property": "deal_currency_code",
    "deal_amount_property": "amount",
    "lifecycle": [
      "erp_proposal",
      "hubspot_deal",
      "proposal_email",
      "followup_analysis",
      "followup_email",
      "won_or_lost",
      "post_sale"
    ]
  }
}
