{
  "openapi": "3.1.0",
  "info": {
    "title": "Agente de Propostas Seta Telecom",
    "version": "2.0.1",
    "description": "Action unica do Agente de Propostas. Orquestra ERP Betel, HubSpot e registro de e-mails do fluxo comercial, desde a criacao/consulta da proposta ate Proposta Enviada e Ganho. O GPT deve preferir a consulta de contexto unificado quando receber um numero de proposta existente."
  },
  "servers": [
    {"url": "https://seta-erp-connector-production-1255.up.railway.app"}
  ],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/health": {
      "get": {
        "operationId": "verificarSaudeAgentePropostas",
        "summary": "Verifica o backend unificado",
        "security": [],
        "responses": {"200": {"description": "Servico ativo"}}
      }
    },
    "/erp/propostas/{numero}/contexto": {
      "get": {
        "operationId": "consultarContextoCompletoProposta",
        "summary": "Consulta uma proposta e seu contexto comercial completo",
        "description": "Use como primeira operacao quando o usuario informar um numero de proposta existente. Busca a proposta no ERP, tenta localizar empresa, contatos, Deal, etapa e historico de e-mails registrados no HubSpot e retorna a proxima acao comercial recomendada. Esta operacao e somente leitura.",
        "parameters": [
          {"name": "numero", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9]+$"}}
        ],
        "responses": {
          "200": {"description": "Contexto completo da proposta"},
          "404": {"description": "Proposta nao encontrada no ERP"}
        }
      }
    },
    "/erp/clientes": {
      "get": {
        "operationId": "buscarClientes",
        "summary": "Busca clientes no ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}},
          {"name": "cnpj", "in": "query", "schema": {"type": "string"}},
          {"name": "email", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Clientes encontrados"}}
      },
      "post": {
        "operationId": "criarCliente",
        "summary": "Cria cliente no ERP",
        "description": "Exija confirmacao explicita imediatamente antes da gravacao.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "required": ["tipo_pessoa", "nome"],
            "properties": {
              "tipo_pessoa": {"type": "string", "enum": ["PF", "PJ", "ES"]},
              "nome": {"type": "string"},
              "razao_social": {"type": "string"},
              "cnpj": {"type": "string"},
              "cpf": {"type": "string"},
              "email": {"type": "string"},
              "telefone": {"type": "string"},
              "celular": {"type": "string"},
              "usuario_id": {"type": "string"},
              "loja_id": {"type": "string"}
            }
          }}}
        },
        "responses": {"200": {"description": "Cliente criado"}}
      }
    },
    "/erp/produtos": {
      "get": {
        "operationId": "buscarProdutos",
        "summary": "Busca produtos no ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}},
          {"name": "codigo_interno", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Produtos encontrados"}}
      }
    },
    "/erp/usuarios": {
      "get": {
        "operationId": "buscarUsuarios",
        "summary": "Busca vendedores e usuarios do ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Usuarios encontrados"}}
      }
    },
    "/erp/situacoes-orcamentos": {
      "get": {
        "operationId": "buscarSituacoesOrcamento",
        "summary": "Lista situacoes de propostas no ERP",
        "responses": {"200": {"description": "Situacoes encontradas"}}
      }
    },
    "/erp/orcamentos": {
      "get": {
        "operationId": "buscarOrcamentos",
        "summary": "Busca propostas no ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "codigo", "in": "query", "description": "Numero comercial da proposta", "schema": {"type": "integer"}},
          {"name": "cliente_id", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Propostas encontradas"}}
      },
      "post": {
        "operationId": "criarOrcamento",
        "summary": "Cria proposta no ERP",
        "description": "Antes de criar, confirme cliente, tipo, solucao, produtos, quantidades, valores, meses quando aplicavel, moeda, vendedor e validade. Consulte o codigo candidato para evitar duplicidade. Exija confirmacao explicita imediatamente antes da gravacao.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "required": ["tipo", "codigo", "cliente_id", "data", "situacao_id", "tipo_proposta", "solucao", "produtos"],
            "properties": {
              "tipo": {"type": "string"},
              "codigo": {"type": "integer"},
              "cliente_id": {"type": "string"},
              "vendedor_id": {"type": "string"},
              "data": {"type": "string"},
              "situacao_id": {"type": "string"},
              "validade": {"type": "string"},
              "tipo_proposta": {"type": "string", "enum": ["locacao", "compra", "spareparts"]},
              "solucao": {"type": "string"},
              "meses": {"type": "integer", "minimum": 1},
              "moeda": {"type": "string", "enum": ["BRL", "USD"], "default": "BRL"},
              "introducao": {"type": "string"},
              "observacoes": {"type": "string"},
              "observacoes_interna": {"type": "string"},
              "valor_frete": {"type": "number"},
              "condicao_pagamento": {"type": "string", "description": "Condição escolhida no módulo de pagamentos do ERP."},
              "forma_pagamento_id": {"type": "string", "description": "ID retornado por buscarFormasPagamentos."},
              "data_primeira_parcela": {"type": "string", "format": "date", "description": "Primeiro vencimento."},
              "numero_parcelas": {"type": "integer", "minimum": 1},
              "intervalo_dias": {"type": "integer", "minimum": 0},
              "pagamentos": {"type": "array", "description": "Grade de parcelas no formato retornado/aceito pelo ERP. O conector transmite a estrutura sem conversão."},
              "desconto_valor": {"type": "string"},
              "desconto_porcentagem": {"type": "string"},
              "produtos": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "object", "properties": {
                  "produto": {"type": "object", "required": ["id", "quantidade", "valor_venda"], "properties": {
                    "id": {"type": "string"},
                    "variacao_id": {"type": "string"},
                    "quantidade": {"type": "string"},
                    "valor_venda": {"type": "string"},
                    "tipo_valor_id": {"type": "string"}
                  }}
                }}
              }
            }
          }}}
        },
        "responses": {"200": {"description": "Proposta criada"}, "400": {"description": "Dados ou regra comercial invalidos"}}
      }
    },
    "/erp/formas-pagamentos": {
      "get": {
        "operationId": "buscarFormasPagamentos",
        "summary": "Lista as formas de pagamento cadastradas no ERP",
        "description": "Use esta rota para preencher o mesmo seletor de forma de pagamento do ERP; não use valores fixos no app.",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Formas de pagamento retornadas pelo ERP"}}
      }
    },
    "/erp/orcamentos/{id}": {
      "get": {
        "operationId": "consultarOrcamento",
        "summary": "Consulta proposta pelo ID interno do ERP",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Proposta encontrada"}}
      }
    },
    "/erp/hubspot/configuracao-proposta": {
      "get": {
        "operationId": "buscarConfiguracaoComercialHubSpot",
        "summary": "Retorna regras comerciais e pipelines",
        "responses": {"200": {"description": "Configuracao comercial"}}
      }
    },
    "/erp/hubspot/empresas": {
      "get": {
        "operationId": "buscarEmpresaHubSpot",
        "summary": "Busca empresa no HubSpot pelo dominio",
        "parameters": [{"name": "domain", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Empresa encontrada ou busca vazia"}}
      }
    },
    "/erp/hubspot/empresas/{id}/contatos": {
      "get": {
        "operationId": "buscarContatosDaEmpresaHubSpot",
        "summary": "Lista contatos associados a uma empresa",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Contatos associados"}}
      }
    },
    "/erp/hubspot/contatos": {
      "get": {
        "operationId": "buscarContatoHubSpot",
        "summary": "Busca contato no HubSpot por e-mail",
        "parameters": [{"name": "email", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Contato encontrado ou busca vazia"}}
      }
    },
    "/erp/hubspot/negocios": {
      "get": {
        "operationId": "buscarNegocioPorProposta",
        "summary": "Verifica duplicidade de Deal pelo numero da proposta",
        "parameters": [{"name": "numero_proposta", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Resultado da busca"}}
      }
    },
    "/erp/hubspot/negocios-da-proposta": {
      "post": {
        "operationId": "criarNegocioHubSpotDaProposta",
        "summary": "Cria Deal no HubSpot a partir da proposta",
        "description": "Antes de gravar, verifique duplicidade, empresa e contatos e obtenha confirmacao explicita. O Deal inicia em Aguardando Proposta.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "required": ["numero_proposta", "empresa", "domain", "solucao", "link_proposta", "tipo_proposta"],
            "properties": {
              "numero_proposta": {"type": "string"},
              "empresa": {"type": "string"},
              "domain": {"type": "string"},
              "solucao": {"type": "string"},
              "link_proposta": {"type": "string"},
              "tipo_proposta": {"type": "string", "enum": ["locacao", "compra", "spareparts"]},
              "valor_mensal": {"type": "number"},
              "meses": {"type": "integer", "minimum": 1},
              "valor_negocio": {"type": "number"},
              "moeda": {"type": "string", "enum": ["BRL", "USD"], "default": "BRL"},
              "contatos": {"type": "array", "items": {"type": "object", "required": ["email"], "properties": {
                "email": {"type": "string"}, "nome": {"type": "string"}, "sobrenome": {"type": "string"}
              }}},
              "hubspot_owner_id": {"type": "string"}
            }
          }}}
        },
        "responses": {"200": {"description": "Deal criado"}, "409": {"description": "Deal duplicado"}}
      }
    },
    "/erp/hubspot/emails/registrar-envio": {
      "post": {
        "operationId": "registrarEmailEnviadoHubSpot",
        "summary": "Registra no HubSpot um e-mail realmente enviado",
        "description": "Execute somente depois da confirmacao real de envio pelo Outlook. Pode associar ao Deal, empresa e contatos e mover o Deal para Proposta Enviada.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "required": ["envio_confirmado", "remetente", "destinatarios", "assunto", "texto"],
            "properties": {
              "envio_confirmado": {"type": "boolean", "const": true},
              "remetente": {"type": "object", "required": ["email"], "properties": {"email": {"type": "string"}, "firstName": {"type": "string"}, "lastName": {"type": "string"}}},
              "destinatarios": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "object", "required": ["email"], "properties": {"email": {"type": "string"}, "firstName": {"type": "string"}, "lastName": {"type": "string"}}}},
              "cc": {"type": "array", "items": {"type": "object", "required": ["email"], "properties": {"email": {"type": "string"}, "firstName": {"type": "string"}, "lastName": {"type": "string"}}}},
              "bcc": {"type": "array", "items": {"type": "object", "required": ["email"], "properties": {"email": {"type": "string"}, "firstName": {"type": "string"}, "lastName": {"type": "string"}}}},
              "assunto": {"type": "string"},
              "texto": {"type": "string"},
              "enviado_em": {"type": "string", "format": "date-time"},
              "outlook_message_id": {"type": "string"},
              "hubspot_owner_id": {"type": "string"},
              "deal_id": {"type": "string"},
              "company_id": {"type": "string"},
              "contact_ids": {"type": "array", "items": {"type": "string"}},
              "atualizar_etapa": {"type": "boolean", "default": false},
              "tipo_proposta": {"type": "string", "enum": ["locacao", "compra", "spareparts"]}
            }
          }}}
        },
        "responses": {"201": {"description": "E-mail registrado"}}
      }
    },
    "/erp/hubspot/negocios/{id}/marcar-proposta-enviada": {
      "post": {
        "operationId": "marcarPropostaEnviadaHubSpot",
        "summary": "Move Deal para Proposta Enviada",
        "description": "Somente depois do envio real do e-mail e com confirmacao.",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "required": ["tipo_proposta", "envio_confirmado"], "properties": {
            "tipo_proposta": {"type": "string", "enum": ["locacao", "compra", "spareparts"]},
            "envio_confirmado": {"type": "boolean", "const": true},
            "solucao": {"type": "string"}
          }
        }}}},
        "responses": {"200": {"description": "Deal atualizado"}}
      }
    },
    "/erp/hubspot/negocios/{id}/marcar-ganho": {
      "post": {
        "operationId": "marcarNegocioGanhoHubSpot",
        "summary": "Marca Deal como Ganho com um ou varios motivos",
        "description": "Apresente Deal e motivos escolhidos e obtenha confirmacao explicita imediatamente antes da gravacao. A rota valida o pipeline e aceita varios motivos simultaneamente.",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object",
          "required": ["tipo_proposta", "motivos_ganho", "confirmacao_ganho"],
          "properties": {
            "tipo_proposta": {"type": "string", "enum": ["locacao", "compra", "spareparts"]},
            "motivos_ganho": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["Nossa Solução foi a Melhor", "Disponibilidade", "Prazo de Entrega", "Relacionamento", "Preço"]}
            },
            "confirmacao_ganho": {"type": "boolean", "const": true}
          }
        }}}},
        "responses": {"200": {"description": "Deal marcado como Ganho"}, "400": {"description": "Confirmacao, motivo ou pipeline invalido"}}
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "Bearer"}
    }
  }
}
