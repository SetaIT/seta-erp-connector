{
  "openapi": "3.1.0",
  "info": {
    "title": "Seta Telecom ERP Connector",
    "version": "1.0.1-json",
    "description": "Conector seguro entre ChatGPT Actions e a API Betel Tecnologia."
  },
  "servers": [
    {
      "url": "https://seta-erp-connector-production-1255.up.railway.app"
    }
  ],
  "paths": {
    "/erp/clientes": {
      "get": {
        "operationId": "buscarClientes",
        "summary": "Busca clientes no ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}},
          {"name": "cnpj", "in": "query", "schema": {"type": "string"}},
          {"name": "email", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Resultado da busca"}
        }
      },
      "post": {
        "operationId": "criarCliente",
        "summary": "Cria um cliente no ERP",
        "description": "tipo_pessoa e nome sao obrigatorios. Para empresa brasileira use PJ.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tipo_pessoa", "nome"],
                "properties": {
                  "tipo_pessoa": {"type": "string", "enum": ["PF", "PJ", "ES"]},
                  "nome": {"type": "string"},
                  "razao_social": {"type": "string"},
                  "cnpj": {"type": "string"},
                  "cpf": {"type": "string"},
                  "email": {"type": "string"},
                  "telefone": {"type": "string"},
                  "celular": {"type": "string"},
                  "usuario_id": {"type": "string"},
                  "loja_id": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Cliente criado"}
        }
      }
    },
    "/erp/produtos": {
      "get": {
        "operationId": "buscarProdutos",
        "summary": "Busca produtos no ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}},
          {"name": "codigo_interno", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Produtos encontrados"}
        }
      }
    },
    "/erp/usuarios": {
      "get": {
        "operationId": "buscarUsuarios",
        "summary": "Lista ou busca usuarios e vendedores do ERP",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "nome", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Usuarios encontrados"}
        }
      }
    },
    "/erp/situacoes-orcamentos": {
      "get": {
        "operationId": "buscarSituacoesOrcamento",
        "summary": "Lista situacoes disponiveis para orcamentos",
        "responses": {
          "200": {"description": "Situacoes encontradas"}
        }
      }
    },
    "/erp/orcamentos": {
      "get": {
        "operationId": "buscarOrcamentos",
        "summary": "Busca orcamentos existentes",
        "parameters": [
          {"name": "pagina", "in": "query", "schema": {"type": "integer", "default": 1}},
          {"name": "codigo", "in": "query", "schema": {"type": "integer"}},
          {"name": "cliente_id", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Orcamentos encontrados"}
        }
      },
      "post": {
        "operationId": "criarOrcamento",
        "summary": "Cria um orcamento ou proposta no ERP",
        "description": "codigo deve ser inteiro.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tipo", "codigo", "cliente_id", "data", "situacao_id"],
                "properties": {
                  "tipo": {"type": "string"},
                  "codigo": {"type": "integer"},
                  "cliente_id": {"type": "string"},
                  "vendedor_id": {"type": "string"},
                  "data": {"type": "string"},
                  "situacao_id": {"type": "string"},
                  "validade": {"type": "string"},
                  "introducao": {"type": "string"},
                  "observacoes": {"type": "string"},
                  "observacoes_interna": {"type": "string"},
                  "valor_frete": {"type": "number"},
                  "desconto_valor": {"type": "string"},
                  "desconto_porcentagem": {"type": "string"},
                  "produtos": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "produto": {
                          "type": "object",
                          "properties": {
                            "id": {"type": "string"},
                            "variacao_id": {"type": "string"},
                            "quantidade": {"type": "string"},
                            "valor_venda": {"type": "string"},
                            "tipo_valor_id": {"type": "string"},
                            "desconto_valor": {"type": "string"},
                            "desconto_porcentagem": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Orcamento criado"}
        }
      }
    },
    "/erp/orcamentos/{id}": {
      "get": {
        "operationId": "consultarOrcamento",
        "summary": "Consulta um orcamento pelo ID interno",
        "description": "Use o ID interno, nao o codigo comercial.",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Orcamento encontrado"}
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {"bearerAuth": []}
  ]
}
