{
  "openapi": "3.1.0",
  "info": {"title": "Seta Rental Billing Isolated", "version": "2.0.0"},
  "servers": [{"url": "https://RENTAL-BILLING-SERVICE"}],
  "paths": {
    "/health": {"get": {"operationId": "verificarSaudeFaturamentoLocacoes", "summary": "Verifica o servico isolado", "security": [], "responses": {"200": {"description": "Servico ativo"}}}},
    "/erp/locacoes/faturamento/preflight": {"post": {"operationId": "validarFaturamentoLocacao", "summary": "Valida faturamento sem gravar", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FaturamentoInput"}}}}, "responses": {"200": {"description": "Validacao concluida"}, "409": {"description": "Duplicidade"}}}},
    "/erp/locacoes/faturamento/executar": {"post": {"operationId": "executarFaturamentoLocacao", "summary": "Cria recebimento e NFS-e", "description": "Exige confirmacao de gravacao. A emissao fiscal exige confirmacao separada.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FaturamentoExecucaoInput"}}}}, "responses": {"201": {"description": "Faturamento criado"}, "409": {"description": "Duplicidade"}}}},
    "/erp/notas-fiscais-servicos": {"get": {"operationId": "buscarNotasFiscaisServicos", "summary": "Busca NFS-e", "responses": {"200": {"description": "Notas encontradas"}}}},
    "/erp/notas-fiscais-servicos/{id}": {"get": {"operationId": "consultarNotaFiscalServico", "summary": "Consulta NFS-e", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Nota encontrada"}}}},
    "/erp/notas-fiscais-servicos/{id}/emitir": {"post": {"operationId": "emitirNotaFiscalServico", "summary": "Emite NFS-e confirmada", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["confirmacao_emissao"], "properties": {"confirmacao_emissao": {"type": "boolean", "const": true}}}}}}, "responses": {"200": {"description": "Nota emitida"}, "400": {"description": "Confirmacao ausente"}}}}
  },
  "components": {
    "schemas": {
      "Recebimento": {"type": "object", "required": ["descricao", "data_vencimento", "plano_contas_id", "forma_pagamento_id", "conta_bancaria_id", "valor", "data_competencia", "cliente_id"], "properties": {"descricao": {"type": "string"}, "data_vencimento": {"type": "string", "format": "date"}, "plano_contas_id": {"type": "integer"}, "forma_pagamento_id": {"type": "integer"}, "conta_bancaria_id": {"type": "integer"}, "valor": {"type": "number", "exclusiveMinimum": 0}, "data_competencia": {"type": "string", "format": "date"}, "cliente_id": {"type": "integer"}}},
      "Nfse": {"type": "object", "required": ["destinatario_id_cliente", "valor_servico", "codigo_atividade", "codigo_natureza_operacao", "iss_retido", "cidade_incidencia_issqn", "estado_incidencia_issqn", "descricao"], "properties": {"destinatario_id_cliente": {"type": "integer"}, "valor_servico": {"type": "number", "exclusiveMinimum": 0}, "codigo_atividade": {"type": "string"}, "codigo_natureza_operacao": {"type": "string"}, "iss_retido": {"type": "integer", "enum": [0, 1]}, "cidade_incidencia_issqn": {"type": "string"}, "estado_incidencia_issqn": {"type": "string"}, "descricao": {"type": "string"}}},
      "FaturamentoInput": {"type": "object", "required": ["idempotency_key", "recebimento", "nfse"], "properties": {"idempotency_key": {"type": "string", "minLength": 8, "maxLength": 100, "pattern": "^[A-Za-z0-9._:-]+$"}, "recebimento": {"$ref": "#/components/schemas/Recebimento"}, "nfse": {"$ref": "#/components/schemas/Nfse"}, "emitir_nfse": {"type": "boolean", "default": false}}},
      "FaturamentoExecucaoInput": {"allOf": [{"$ref": "#/components/schemas/FaturamentoInput"}, {"type": "object", "required": ["confirmacao_gravacao"], "properties": {"confirmacao_gravacao": {"type": "boolean", "const": true}, "confirmacao_emissao": {"type": "boolean"}}}]}
    },
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}}
  },
  "security": [{"bearerAuth": []}]
}
